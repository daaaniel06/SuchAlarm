{
  "name": "suchalarm",
  "private": true,
  "description": "Frontend-Werkzeuge: Formatierung, Lint und Unit-Tests für suchalarm/static",
  "scripts": {
    "format": "prettier --write \"suchalarm/static/*.{js,css}\" \"suchalarm/preis/extract.js\" \"tests/*.js\"",
    "format:check": "prettier --check \"suchalarm/static/*.{js,css}\" \"suchalarm/preis/extract.js\" \"tests/*.js\"",
    "lint": "eslint suchalarm/static/*.js suchalarm/preis/extract.js tests/*.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "prettier": "3.3.3"
  }
}
