{
  "name": "suchalarm",
  "private": true,
  "description": "Frontend-Werkzeuge: Formatierung, Lint und Unit-Tests für suchalarm/static",
  "scripts": {
    "format": "prettier --write \"suchalarm/static/*.{js,css}\" \"suchalarm/preis/extract.js\" \"tests/*.js\"",
    "format:check": "prettier --check \"suchalarm/static/*.{js,css}\" \"suchalarm/preis/extract.js\" \"tests/*.js\"",
    "lint": "eslint suchalarm/static/*.js suchalarm/preis/extract.js tests/*.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "prettier": "3.3.3"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "all"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-undef": "error",
      "no-redeclare": "error",
      "no-import-assign": "error",
      "no-unused-vars": "warn",
      "no-shadow": "warn"
    },
    "overrides": [
      {
        "files": [
          "suchalarm/preis/extract.js"
        ],
        "parserOptions": {
          "sourceType": "script"
        }
      },
      {
        "files": [
          "tests/**/*.js"
        ],
        "env": {
          "node": true,
          "browser": false
        },
        "parserOptions": {
          "sourceType": "script"
        }
      }
    ]
  }
}
