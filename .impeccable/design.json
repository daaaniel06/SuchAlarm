  "narrative": {
    "northStar": "Das persönliche Preis-Depot",
    "overview": "Preisalarme übernehmen die verbindliche visuelle Welt von Wohnungsbot: Geist, Weiß und Schwarz, ruhige Positionslisten und große Zähler. Die Oberfläche wirkt persönlich, sachlich und leicht. Preise, Quellen und Aktualität erhalten Vorrang vor dekorativen Flächen.\n\nDie Darstellung folgt automatisch dem hellen oder dunklen Systemmodus. Flächen werden durch Tonwerte und Abstände gegliedert; Farbe trägt fachliche Bedeutung. Desktop-Seitenleiste und mobile Bodennavigation bilden dieselbe ruhige Orientierung.",
    "keyCharacteristics": [
      "Monochrome Grundfläche mit semantischen Farbsignalen.",
      "Kompakte, offene Listen und großzügige Abschnittsabstände.",
      "Große Kennzahlen, tabellarische Beträge und lokal geladene Geist."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Grün markiert passende Preise, neue Treffer und aktive Schalter; Bernstein markiert unsichere oder veraltete Daten, Rot Fehler und gefährliche Aktionen. Quellenfarben bleiben auf Quellenkennzeichen begrenzt.",
        "section": "Colors"
      },
      {
        "name": "The Price Alignment Rule",
        "body": "Beträge und Kennzahlen verwenden tabellarische Ziffern; Angebotspreise stehen rechts und bleiben als zusammenhängender Betrag lesbar.",
        "section": "Typography"
      },
      {
        "name": "The One Navigation Rule",
        "body": "Ab dem mobilen Umbruch ersetzt die Bodennavigation die Seitenleiste. Reservierter Platz unter dem Inhalt hält die letzten Aktionen erreichbar.",
        "section": "Layout"
      },
      {
        "name": "The Quiet List Rule",
        "body": "Angebote und Suchen bleiben offene Zeilen ohne Schatten und ohne dauerhafte Kartenrahmen. Hover hebt die Zeile durch einen neutralen Tonwert hervor.",
        "section": "Elevation & Depth"
      },
      {
        "name": "The Shipping Context Rule",
        "body": "Der Versand-Schalter gehört in dieselbe Feldgruppe wie Suchbegriff und Höchstpreis. Die Erläuterung darunter beschreibt die Auswirkung auf den Alarm.",
        "section": "Components"
      }
    ],
    "dos": [
      "Do dieselben semantischen Rollen in beiden Systemmodi erhalten.",
      "Do Angebote als ruhige Zeilen mit erkennbarem Quellenzeichen und rechtsbündigem Preis darstellen.",
      "Do sichtbare Fokusmarkierungen und reduzierte Bewegung erhalten.",
      "Do Versand je Suche unmittelbar beim Höchstpreis anbieten."
    ],
    "donts": [
      "Don't zusätzliche dekorative Akzentfarben oder Verlaufshintergründe einführen.",
      "Don't offene Angebotslisten durch schwebende Karten oder Schattenraster ersetzen.",
      "Don't mobile Inhalte hinter der Bodennavigation verstecken."
    ]
  }
